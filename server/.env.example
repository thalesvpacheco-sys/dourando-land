# Banco (PostgreSQL 14+ com PostGIS 3)
DATABASE_URL=postgres://dl:dl@localhost:5432/dourado
PORT=4200
PUBLIC_WEB_URL=http://localhost:5174
# Assina as sessões do login próprio
AUTH_JWT_SECRET=troque-este-segredo
# Exige duas etapas de perfis administrativos (padrão: false)
REQUIRE_MFA=false
# Seletor de usuários fictícios na tela de login (somente desenvolvimento; ignorado com NODE_ENV=production)
ENABLE_DEV_LOGIN=true
# Chave de 32 bytes (hex) para criptografia de CPF/CNPJ e assinatura de URLs
DATA_KEY=
# CRM / Leads Hub da WingsBr — sem URL o adaptador roda em modo embutido (simulado)
WINGSBR_CRM_URL=
WINGSBR_CRM_SECRET=
# WhatsApp Business Platform (Cloud API)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Armazenamento local (S3 pendente)
STORAGE_DIR=./storage
# IA opcional
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
