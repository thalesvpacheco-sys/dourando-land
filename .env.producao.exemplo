# Copie para .env. Nunca envie este arquivo preenchido por e-mail ou chat.
# Gere cada segredo com: openssl rand -hex 32
DOMINIO=queroarea.com.br
# Endereço anterior: redireciona para o DOMINIO mantendo o caminho
DOMINIO_ANTIGO=areas.douradoimob.com.br
DB_PASSWORD=
AUTH_JWT_SECRET=
# ATENÇÃO: cifra CPF/CNPJ. Guarde uma cópia segura; sem ela esses dados não podem ser lidos.
DATA_KEY=

# Bases territoriais carregadas com `territory:import`
TERRITORY_MODE=live
# CAR (imóveis): consulta ao vivo no serviço público do SICAR, sem carga
TERRITORY_CAR_WFS_URL=https://geoserver.car.gov.br/geoserver/sicar/wfs
TERRITORY_CAR_LAYER=sicar:sicar_imoveis_{uf_lower}
# Duas etapas (aplicativo autenticador) para administradores: desligado por padrão
REQUIRE_MFA=false

# Opcional: e-mail de convite e "esqueci a senha". Sem isso, o admin copia o link.
SMTP_URL=
MAIL_FROM=Dourado Land Intelligence <no-reply@douradoimob.com.br>

# Opcional: satélite da Mapbox. O token fica só no servidor (o navegador pede os blocos em /api/map).
# Teto diário de blocos para não sair da faixa gratuita (padrão 6000 ≈ 180 mil/mês).
MAPBOX_TOKEN=
MAPBOX_DAILY_LIMIT=6000

# Opcional: outro provedor de satélite (template XYZ) e hosts liberados na política de segurança
VITE_SATELLITE_TILES=
VITE_SATELLITE_ATTRIBUTION=
CSP_EXTRA_HOSTS=
VITE_MAP_STYLE_URL=

# Opcional: leitura de matrícula e redação assistida
ANTHROPIC_API_KEY=

# Opcional: consulta registral via provedor contratado; WhatsApp oficial; CRM
ONR_PROVIDER_URL=
ONR_PROVIDER_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WINGSBR_CRM_URL=
WINGSBR_CRM_SECRET=

# Opcional: vista 3D fotorrealista (Google 3D Maps). Chave da Google Maps Platform com Map Tiles API e Maps JavaScript API,
# restrita ao domínio (referenciadores HTTP). Fica visível no navegador: a restrição de domínio é o que a protege.
VITE_GOOGLE_MAPS_API_KEY=
